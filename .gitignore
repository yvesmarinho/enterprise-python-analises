# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Logs
*.log

# Temporary working files (session scratch only)
tmp/*
!tmp/.gitkeep

# Secrets and credentials (NEVER commit)
.secrets/
.env
*.key
*.pem
*credentials*.json
!credentials.template.json

# Analysis output reports (tracked via .gitkeep but content excluded)
reports/*
!reports/.gitkeep

# IDE / Editor
.vscode/settings.json
.idea/

# OS artifacts
.DS_Store
Thumbs.db
