# ANA-001 N8N Performance Analyzer — required environment variables
# Copy this file to .env and populate, OR source values from .secrets/
# Never commit real values. All paths below must be 640 permissions.

# ── Observability Stack ──────────────────────────────────────────────────────
# Architecture (docs/Prometheus/docker-compose.yaml):
#   Prometheus      — public HTTPS via Traefik, 15d retention, always reachable.
#   VictoriaMetrics — internal-only (http://victoriametrics:8428, no public DNS),
#                     12-month retention. Requires SSH tunnel to wfdb01 or running
#                     from inside the observability network to be reachable.
#
# ANA-001 uses VICTORIA_METRICS_URL as primary (longer history).
# When VICTORIA_METRICS_URL is not set or unreachable, it falls back to PROMETHEUS_URL.
# For local analysis: comment out VICTORIA_METRICS_URL unless you have a tunnel.
#
# SSH tunnel (SPA via fwknop — necessário para VictoriaMetrics / dados > 15 dias):
#   fwknop --rc-file ~/.fwknoprc -n wfdb01 && sleep 3 && \
#     ssh -p 5010 -N -L 8428:victoriametrics:8428 archaris@wfdb01.vya.digital
#   Ou use o helper: source .secrets/wfdb01_connection.sh && wfdb01_tunnel_vm
#   Then set: VICTORIA_METRICS_URL=http://localhost:8428

# Uncomment and set when running with SSH tunnel to wfdb01:
# VICTORIA_METRICS_URL=http://localhost:8428

PROMETHEUS_URL=https://prometheus.vya.digital
LOKI_URL=https://loki.vya.digital
# Loki multi-tenancy: auth_enabled=true requires X-Scope-OrgID header.
# Promtail writes with tenant_id=production — use this value to read real data.
# Without this header, Loki returns HTTP 401 Unauthorized.
LOKI_TENANT_ID=production
# LOKI_BEARER_TOKEN=CHANGEME

# ── Database (read-only monitor_user account) ────────────────────────────────
POSTGRES_DSN=postgresql://monitor_user:CHANGEME@wfdb02.vya.digital:5432/n8n

# ── HTTP Client ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=30

# ── Analysis Defaults ────────────────────────────────────────────────────────
CORRELATION_WINDOW_SECONDS=30
