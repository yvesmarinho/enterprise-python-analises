# ANA-001 N8N Performance Analyzer — required environment variables
# Copy this file to .env and populate, OR source values from .secrets/
# Never commit real values. All paths below must be 640 permissions.

# ── Observability Stack ──────────────────────────────────────────────────────
VICTORIA_METRICS_URL=https://victoriametrics.vya.digital
LOKI_URL=https://loki.vya.digital
PROMETHEUS_URL=https://prometheus.vya.digital

# ── Database (read-only monitor_user account) ────────────────────────────────
POSTGRES_DSN=postgresql://monitor_user:CHANGEME@wfdb02.vya.digital:5432/n8n

# ── HTTP Client ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=30

# ── Analysis Defaults ────────────────────────────────────────────────────────
CORRELATION_WINDOW_SECONDS=30
